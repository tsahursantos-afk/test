			<Item class="Script" referent="RBX6F7C1EDF4C8A4E90946EA405D2E731AD">
				<Properties>
					<ProtectedString name="Source"><![CDATA[function findNearestHumanoidRootPart(pos)
	local list = workspace:children()
	local HumanoidRootPart = nil
	local dist = 200
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		if temp2:IsA("Model") and temp2 ~= script.Parent then
			temp = temp2:FindFirstChild("HumanoidRootPart")
			human = temp2:FindFirstChild("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).Magnitude < dist then
					HumanoidRootPart = temp
					dist = (temp.Position - pos).Magnitude

				end
			end
		end
	end
	return HumanoidRootPart
end

while wait() do
	wait(0.1)
	local target = findNearestHumanoidRootPart(script.Parent:WaitForChild("RushNew").Position)
	if target ~= nil then
		if (target.Position - script.Parent:WaitForChild("RushNew").Position).Magnitude < 120 then
			game.ReplicatedStorage.Bricks.FireCamera:FireAllClients(2, 18, 0, 0.7)
		end

		if (target.Position - script.Parent:WaitForChild("RushNew").Position).Magnitude < 50 then
			game.ReplicatedStorage.Bricks.FireCamera:FireAllClients(12, 36, 0, 0.7)
		end
	end
end
]]></ProtectedString>
